# انسخ هذا الملف إلى .env وعدّل ما تحتاج. كل شيء اختياري.

# ---- المسارات
STORAGE_DIR=storage                 # الفيديوهات/الشرائح/ChromaDB/قاعدة الحالة
YOLO_CLS_WEIGHTS=models/best.pt     # نموذج التصنيف المدرَّب (ناتج التدريب)

# ---- الرؤية
FRAME_INTERVAL=2.0                  # إطار كل كم ثانية
SLIDE_CHANGE_THRESHOLD=0.004        # نسبة تغيّر مساحة الإطار لاعتباره شريحة جديدة (ارفعها إن انقسمت الشريحة الواحدة)
MIN_SLIDE_FRAMES=2                  # أقل عدد إطارات لتُعتبر شريحة (تجاهل الومضات)

# ---- OCR (PaddleOCR)
OCR_LANGS=ar,en
OCR_MIN_SCORE=0.5

# ---- الصوت (Whisper)
ASR_MODEL=auto                      # auto = large-v3 على GPU وإلا small | أو medium/small
ASR_QUERY_MODEL=small               # نموذج الأسئلة الصوتية
ASR_LANGUAGE=ar                     # ar | en | auto

# ---- Qwen (التصحيح السياقي + توليد الإجابة)
QWEN_BACKEND=auto                   # auto: local إن وُجد GPU، وإلا api إن ضُبط، وإلا off | local | api | off
QWEN_MODEL=Qwen/Qwen2.5-3B-Instruct # للتشغيل المحلي (GPU)
# للتشغيل عبر API متوافق مع OpenAI (مثال Alibaba DashScope):
QWEN_API_BASE=
QWEN_API_KEY=
QWEN_API_MODEL=qwen-plus

# ---- التضمين (ChromaDB)
EMBED_BACKEND=auto                  # auto | st | hash
EMBED_MODEL=intfloat/multilingual-e5-small

# ---- الخادم
API_KEY=                            # إن ضُبط، يجب أن يرسل التطبيق الترويسة X-API-Key
MAX_UPLOAD_MB=4096
PUBLIC_BASE_URL=                    # مثال https://api.example.com (لروابط الصور في الردود)
TOP_K=5
CORS_ORIGINS=*
